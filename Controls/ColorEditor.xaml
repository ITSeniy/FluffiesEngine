<UserControl x:Class="FluffiesEngine.Controls.ColorEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <StackPanel Margin="0,6,0,6">

        <Grid Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Title, ElementName=Root}"
                       Foreground="{StaticResource TextMutedBrush}" FontSize="12" FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Foreground="{StaticResource TextMutedBrush}" FontSize="11"
                       VerticalAlignment="Center"
                       Text="{Binding Color, ElementName=Root, Converter={StaticResource ColorToHex}}"/>
        </Grid>

        <DockPanel>
            <Border DockPanel.Dock="Left" Width="46" Height="46" CornerRadius="10" Margin="0,0,12,0"
                    BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1"
                    Background="{Binding Color, ElementName=Root, Converter={StaticResource ColorToBrush}}">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="0" BlurRadius="14" Opacity="0.5"
                                      Color="#000000"/>
                </Border.Effect>
            </Border>

            <StackPanel VerticalAlignment="Center">
                <Slider Style="{StaticResource ChannelSlider}" Minimum="0" Maximum="255"
                        Value="{Binding R, ElementName=Root, Mode=TwoWay}"/>
                <Slider Style="{StaticResource ChannelSlider}" Minimum="0" Maximum="255" Margin="0,4,0,0"
                        Value="{Binding G, ElementName=Root, Mode=TwoWay}"/>
                <Slider Style="{StaticResource ChannelSlider}" Minimum="0" Maximum="255" Margin="0,4,0,0"
                        Value="{Binding B, ElementName=Root, Mode=TwoWay}"/>
            </StackPanel>
        </DockPanel>

        <WrapPanel x:Name="SwatchPanel" Margin="0,8,0,0"/>
    </StackPanel>
</UserControl>
