<Window x:Class="FluffiesEngine.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:h="clr-namespace:HelixToolkit.Wpf;assembly=HelixToolkit.Wpf"
        xmlns:ctrl="clr-namespace:FluffiesEngine.Controls"
        xmlns:models="clr-namespace:FluffiesEngine.Models"
        Title="Fluffies Engine" Height="840" Width="1320"
        MinHeight="700" MinWidth="1080"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource BgDeepBrush}"
        Foreground="{StaticResource TextBrush}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="58" ResizeBorderThickness="6"
                      CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Window caption buttons -->
        <Style x:Key="WindowButton" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="8" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource BgCardHoverBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WindowCloseButton" TargetType="Button" BasedOn="{StaticResource WindowButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>

            <!-- ===================== Header / Title bar ==================== -->
            <Border Grid.Row="0" Background="{StaticResource HeaderBrush}"
                    BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="18,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Brand -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource AccentBrush}">
                            <Border.Effect>
                                <DropShadowEffect Color="#FF6FB5" BlurRadius="16" ShadowDepth="0" Opacity="0.7"/>
                            </Border.Effect>
                            <TextBlock Text="🐾" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="FLUFFIES ENGINE" FontSize="15" FontWeight="Bold"/>
                            <TextBlock Text="3D Furry Character Designer" FontSize="10.5"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Toolbar -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource AccentButton}" Command="{Binding RandomizeCommand}"
                                Content="🎲  Randomize" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource ToolButton}" Command="{Binding ResetCommand}"
                                Content="↺  Reset" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource ToolButton}" Click="OnExportPng"
                                Content="🖼  Export PNG" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource ToolButton}" Command="{Binding SaveCommand}"
                                Content="💾  Save" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource ToolButton}" Command="{Binding LoadCommand}"
                                Content="📂  Load"/>
                    </StackPanel>

                    <!-- Window controls -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="14,0,0,0" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource WindowButton}" Click="OnMinimize" Content="&#xE921;"/>
                        <Button x:Name="MaxButton" Click="OnMaximizeRestore">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource WindowButton}">
                                    <Setter Property="Content" Value="&#xE922;"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                            <Setter Property="Content" Value="&#xE923;"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Style="{StaticResource WindowCloseButton}" Click="OnClose" Content="&#xE8BB;"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===================== Main content ========================= -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="386"/>
                </Grid.ColumnDefinitions>

                <!-- 3D Viewport -->
                <Border Grid.Column="0" Background="{StaticResource ViewportBrush}" ClipToBounds="True">
                    <Grid>
                        <h:HelixViewport3D x:Name="Viewport"
                                           Background="Transparent"
                                           ShowViewCube="True" ViewCubeOpacity="0.65"
                                           ViewCubeBackText="B" ViewCubeFrontText="F"
                                           ShowCoordinateSystem="False"
                                           ShowFrameRate="False"
                                           IsHeadLightEnabled="False"
                                           ZoomExtentsWhenLoaded="False"
                                           InfiniteSpin="False">
                            <h:HelixViewport3D.Camera>
                                <PerspectiveCamera Position="2.2,1.32,4.4"
                                                   LookDirection="-2.2,-0.48,-4.4"
                                                   UpDirection="0,1,0" FieldOfView="42"/>
                            </h:HelixViewport3D.Camera>

                            <!-- Lighting rig -->
                            <ModelVisual3D>
                                <ModelVisual3D.Content>
                                    <Model3DGroup>
                                        <AmbientLight Color="#2E2A42"/>
                                        <DirectionalLight Color="#FFF4FA" Direction="-0.4,-0.85,-0.75"/>
                                        <DirectionalLight Color="#43528F" Direction="0.85,-0.1,0.5"/>
                                        <DirectionalLight Color="#FF6FB5" Direction="0.3,0.45,-1.0"/>
                                    </Model3DGroup>
                                </ModelVisual3D.Content>
                            </ModelVisual3D>

                            <!-- Ground grid -->
                            <h:GridLinesVisual3D Center="0,0,0" Width="16" Length="16"
                                                 MinorDistance="0.5" MajorDistance="2" Thickness="0.006"
                                                 Normal="0,1,0" LengthDirection="0,0,1" Fill="#2B2740"/>

                            <!-- The character -->
                            <ModelVisual3D Content="{Binding CharacterModel}"/>
                        </h:HelixViewport3D>

                        <!-- viewport hint -->
                        <Border VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="16"
                                Background="#66100E1A" CornerRadius="9" Padding="12,7">
                            <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="11"
                                       Text="Left-drag · orbit    Wheel · zoom    Right-drag · pan"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- ===================== Control panel ==================== -->
                <Border Grid.Column="1" Background="{StaticResource BgPanelBrush}"
                        BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1,0,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Padding="16,16,12,16">
                        <StackPanel>

                            <!-- Identity -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="CHARACTER"/>
                                    <TextBox Text="{Binding Parameters.Name, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Border>

                            <!-- Species -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="SPECIES"/>
                                    <ItemsControl ItemsSource="{Binding Presets}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type models:SpeciesPreset}">
                                                <Button Style="{StaticResource ToolButton}" Width="76" Margin="0,0,7,7"
                                                        Padding="4,8"
                                                        AutomationProperties.Name="{Binding Name}"
                                                        ToolTip="{Binding Name}"
                                                        Command="{Binding DataContext.ApplyPresetCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Emoji}" FontSize="22"
                                                                   HorizontalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Name}" FontSize="11" Margin="0,3,0,0"
                                                                   HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Colors -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="COLORS"/>
                                    <ctrl:ColorEditor Title="Fur" Color="{Binding Parameters.FurPrimary, Mode=TwoWay}"/>
                                    <ctrl:ColorEditor Title="Accent / Belly" Color="{Binding Parameters.FurSecondary, Mode=TwoWay}"/>
                                    <ctrl:ColorEditor Title="Eyes" Color="{Binding Parameters.EyeColor, Mode=TwoWay}"/>
                                    <CheckBox Content="Horns" Margin="0,8,0,0" IsChecked="{Binding Parameters.Horns}"/>
                                </StackPanel>
                            </Border>

                            <!-- Body -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="BODY"/>
                                    <ctrl:LabeledSlider Label="Height"      Minimum="0.8"  Maximum="1.3"  Value="{Binding Parameters.Height, Mode=TwoWay}"/>
                                    <ctrl:LabeledSlider Label="Build"       Minimum="0.6"  Maximum="1.6"  Value="{Binding Parameters.Build, Mode=TwoWay}"/>
                                    <ctrl:LabeledSlider Label="Head size"   Minimum="0.8"  Maximum="1.4"  Value="{Binding Parameters.HeadSize, Mode=TwoWay}"/>
                                    <ctrl:LabeledSlider Label="Limb length" Minimum="0.8"  Maximum="1.25" Value="{Binding Parameters.LimbLength, Mode=TwoWay}"/>
                                </StackPanel>
                            </Border>

                            <!-- Face -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="FACE"/>
                                    <ctrl:LabeledSlider Label="Snout length" Minimum="0.0" Maximum="1.5" Value="{Binding Parameters.SnoutLength, Mode=TwoWay}"/>
                                    <ctrl:LabeledSlider Label="Ear size"     Minimum="0.5" Maximum="1.7" Value="{Binding Parameters.EarSize, Mode=TwoWay}"/>
                                    <TextBlock Text="Ear shape" Foreground="{StaticResource TextMutedBrush}"
                                               FontSize="12" Margin="0,8,0,6"/>
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource Segment}" GroupName="ear" Content="Pointed"
                                                     IsChecked="{Binding Parameters.EarShape, Converter={StaticResource EnumMatch}, ConverterParameter=Pointed}"/>
                                        <RadioButton Style="{StaticResource Segment}" GroupName="ear" Content="Round"
                                                     IsChecked="{Binding Parameters.EarShape, Converter={StaticResource EnumMatch}, ConverterParameter=Round}"/>
                                        <RadioButton Style="{StaticResource Segment}" GroupName="ear" Content="Long"
                                                     IsChecked="{Binding Parameters.EarShape, Converter={StaticResource EnumMatch}, ConverterParameter=Long}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Tail -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="TAIL"/>
                                    <ctrl:LabeledSlider Label="Length"   Minimum="0.3" Maximum="1.7" Value="{Binding Parameters.TailLength, Mode=TwoWay}"/>
                                    <ctrl:LabeledSlider Label="Fluff"    Minimum="0.4" Maximum="1.8" Value="{Binding Parameters.TailFluff, Mode=TwoWay}"/>
                                </StackPanel>
                            </Border>

                            <!-- Material -->
                            <Border Style="{StaticResource Card}" Margin="0,0,0,0">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="MATERIAL"/>
                                    <ctrl:LabeledSlider Label="Glossiness" Minimum="0.0" Maximum="1.0" Value="{Binding Parameters.Glossiness, Mode=TwoWay}"/>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- ===================== Status bar =========================== -->
            <Border Grid.Row="2" Background="{StaticResource BgPanelBrush}"
                    BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,1,0,0">
                <Grid Margin="16,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🐾" FontSize="11" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Parameters.Name}" Margin="7,0,0,0" FontSize="11"
                                   FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}"
                               Text="{Binding TriangleCount, StringFormat={}{0:N0} triangles}"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
